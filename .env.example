# Optional: npm run connect saves a local connection. To override it, supply BOTH:
# PINGROOM_TOKEN=
# PINGROOM_ROOM=
# Defaults below are optional. npm start loads .env; existing shell variables win.
HANDOFF_FILE=./handoff.json
RUN_BUDGET_MS=60000
# Optional absolute path for persistent receipt files; default is this repo's .receipts/
# RECEIPTS_DIR=/absolute/path/to/receipts
